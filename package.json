{
  "name": "blur-score",
  "version": "1.0.6",
  "description": "Detect how blurry an image is (0-1 sharpness score) using Laplacian variance",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vjymisal0/blur-score.git"
  },
  "homepage": "https://github.com/vjymisal0/blur-score#readme",
  "bugs": {
    "url": "https://github.com/vjymisal0/blur-score/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./src/index.d.cts",
        "default": "./src/index.cjs"
      }
    }
  },
  "files": [
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "blur",
    "blur-detection",
    "image-processing",
    "sharpness",
    "laplacian",
    "sharp"
  ],
  "author": "Vijay Misal <misalvijay153@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": ">=18"
  }
}
